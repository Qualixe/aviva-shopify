{%- doc -%}
  Renders the collection filter sidebar (accordion filter groups + price range slider).

  @param {object} collection - The collection whose `collection.filters` should be rendered.

  @example
  {% render 'collection-filters', collection: collection %}
{%- enddoc -%}

{% liquid
    assign any_filter_active = false
    for filter in collection.filters
        if filter.active_values.size > 0
            assign any_filter_active = true
        endif
    endfor
%}
<div class="collection-filter">
    <span class="filter-window-close-btn"></span>
    <div class="filter-box">
        <h6 class="filter-sidebar-heading h6">Filter
            {% if any_filter_active %}
                <a href="{{ collection.url }}" class="filter-clear-btn">Clear all</a>
            {% endif %}
            <span class="filter-close-btn">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3 15L15 3" stroke="#232323" stroke-width="1.5" stroke-linecap="round"
                        stroke-linejoin="round">
                    </path>
                    <path d="M15 15L3 3" stroke="#232323" stroke-width="1.5" stroke-linecap="round"
                        stroke-linejoin="round">
                    </path>
                </svg>
            </span>
        </h6>
        <div class="filter-accordion">
            <div class="filter-accordion-items">
                {% for filter in collection.filters %}
                    {% liquid
                        assign filter_label_downcase = filter.label | downcase
                        assign is_color_filter = false
                        if filter_label_downcase contains 'colo'
                            assign is_color_filter = true
                        endif
                    %}
                    <div class="filter-accordion-item">
                        <div class="item-title-wrapper accordion-toggle-btn">
                            <h6 class="item-title">{{ filter.label }}</h6>
                            <span class="icon">
                                <svg aria-hidden="true" focusable="false" class="icon icon-caret" viewBox="0 0 10 6">
                                    <path fill-rule="evenodd" clip-rule="evenodd"
                                        d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z"
                                        fill="currentColor">
                                    </path>
                                </svg>
                            </span>
                        </div>
                        <div class="filter-accordion-item-content">
                            {% case filter.type %}
                                {% when 'list', 'boolean' %}
                                    <div class="filter-options-wrapper">
                                        {% for value in filter.values %}
                                            {% if value.count == 0 and value.active == false %}
                                                {% continue %}
                                            {% endif %}
                                            <div class="filter-options">
                                                <div class="filter-option{% if is_color_filter %} color-{{ value.label | handle }}{% endif %}">
                                                    <input
                                                        type="checkbox"
                                                        class="filter-option-input"
                                                        id="Filter-{{ filter.label | handle }}-{{ forloop.index }}"
                                                        name="{{ value.param_name }}"
                                                        value="{{ value.value }}"
                                                        {% if value.active %}checked{% endif %}
                                                        {% if value.count == 0 %}disabled{% endif %}
                                                    >
                                                    <label class="filter-option-label" for="Filter-{{ filter.label | handle }}-{{ forloop.index }}">{{ value.label }}</label>
                                                </div>
                                                <span class="filter-item-number">{{ value.count }}</span>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% when 'price_range' %}
                                    {% liquid
                                        assign range_max = filter.range_max | money_without_currency | replace: ',', ''
                                        assign current_min = filter.min_value.value | default: 0 | money_without_currency | replace: ',', ''
                                        assign current_max = filter.max_value.value | default: filter.range_max | money_without_currency | replace: ',', ''
                                    %}
                                    <div class="price-range-wrap">
                                        <div class="price-range-slider">
                                            <div class="price-range-track"></div>
                                            <div class="price-range-track-fill"></div>
                                            <input type="range" class="price-range-input price-range-input-min"
                                                name="{{ filter.min_value.param_name }}"
                                                min="0" max="{{ range_max }}" value="{{ current_min }}" step="1">
                                            <input type="range" class="price-range-input price-range-input-max"
                                                name="{{ filter.max_value.param_name }}"
                                                min="0" max="{{ range_max }}" value="{{ current_max }}" step="1">
                                        </div>
                                        <div class="price-range-values">
                                            <div class="price-range-field">
                                                <span class="currency">{{ cart.currency.symbol }}</span>
                                                <span class="price-range-value price-range-value-min">{{ current_min }}</span>
                                            </div>
                                            <span class="price-range-sep">to</span>
                                            <div class="price-range-field">
                                                <span class="currency">{{ cart.currency.symbol }}</span>
                                                <span class="price-range-value price-range-value-max">{{ current_max }}</span>
                                            </div>
                                        </div>
                                    </div>
                            {% endcase %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

{% stylesheet %}
    .filter-clear-btn {
        margin-left: 8px;
        font-size: 12px;
        font-weight: 400;
        text-decoration: underline;
        color: var(--brand-color);
    }

    .filter-option-input:disabled + .filter-option-label {
        opacity: 0.4;
        pointer-events: none;
    }
{% endstylesheet %}

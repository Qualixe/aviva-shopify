0X20X15 cm\n      </div>\n\n      <!-- IMAGE SLIDER -->\n\n      <div class=\"av-slider-box\">\n\n        <div class=\"av-slider\">\n\n          <div class=\"av-slide\">\n            <img\n              src=\"{{ av_bag_1 }}\"\n              alt=\"Brown Shoulder Bag\"\n              loading=\"lazy\"\n              width=\"400\"\n              height=\"450\">\n          </div>\n\n          <div class=\"av-slide\">\n            <img\n              src=\"{{ av_bag_2 }}\"\n              alt=\"Black Shoulder Bag\"\n              loading=\"lazy\"\n              width=\"400\"\n              height=\"450\">\n          </div>\n\n          <div class=\"av-slide\">\n            <img\n              src=\"{{ av_bag_3 }}\"\n              alt=\"Tan Shoulder Bag\"\n              loading=\"lazy\"\n              width=\"400\"\n              height=\"450\">\n          </div>\n\n        </div>\n      </div>\n\n      <!-- ORDER BUTTON -->\n\n      <div class=\"av-button-area\">\n        <a href=\"{{ av_order_target }}\" class=\"av-buy\">\n          <span class=\"av-buy-icon\">👍</span>\n          আমি এখনি কিনতে চাই\n        </a>\n      </div>\n\n    </div>\n  </div>\n\n  <!-- DISCOUNT BANNER -->\n\n  <div class=\"av-price-banner\">\n    <div class=\"av-wrap\">\n\n      <h2>আজই অর্ডার করুন 36% ডিসকাউন্টে</h2>\n\n      <div class=\"av-price-line\">\n\n        <span class=\"av-old-price\">\n          Old Price <s>1550</s> Taka\n        </span>\n\n        <span class=\"av-new-price\">\n          Offer Price Only\n          <span class=\"av-highlight\">990 Taka</span>\n        </span>\n\n      </div>\n\n    </div>\n  </div>\n\n</div>\n\n\n<style>\n/* Smooth automatic image slider */\n.av-ref .av-slider {\n  scroll-behavior: smooth;\n  cursor: grab;\n  user-select: none;\n  touch-action: pan-x;\n}\n\n.av-ref .av-slider:active {\n  cursor: grabbing;\n}\n\n.av-ref .av-slide img {\n  pointer-events: none;\n  user-select: none;\n}\n</style>\n\n<script>\n(function () {\n  function initAvivaSliders() {\n    document.querySelectorAll('.av-ref .av-slider').forEach(function(slider) {\n      if (slider.dataset.autoInitialized === 'true') return;\n      slider.dataset.autoInitialized = 'true';\n\n      const slides = Array.from(\n        slider.querySelectorAll('.av-slide')\n      );\n\n      if (slides.length < 2) return;\n\n      let current = 0;\n      let timer = null;\n      let paused = false;\n      let isDragging = false;\n      let startX = 0;\n      let startScrollLeft = 0;\n\n      function goToSlide(index) {\n        current = (index + slides.length) % slides.length;\n\n        slider.scrollTo({\n          left: slides[current].offsetLeft - slides[0].offsetLeft,\n          behavior: 'smooth'\n        });\n      }\n\n      function startAutoSlide() {\n        stopAutoSlide();\n\n        timer = setInterval(function() {\n          if (!paused && !isDragging) {\n            goToSlide(current + 1);\n          }\n        }, 3000);\n      }\n\n      function stopAutoSlide() {\n        if (timer) {\n          clearInterval(timer);\n          timer = null;\n        }\n      }\n\n      slider.addEventListener('mouseenter', function() {\n        paused = true;\n      });\n\n      slider.addEventListener('mouseleave', function() {\n        paused = false;\n        isDragging = false;\n      });\n\n      slider.addEventListener('pointerdown', function(e) {\n        if (e.pointerType === 'touch') return;\n\n        isDragging = true;\n        paused = true;\n        startX = e.clientX;\n        startScrollLeft = slider.scrollLeft;\n      });\n\n      slider.addEventListener('pointermove', function(e) {\n        if (!isDragging) return;\n\n        slider.scrollLeft =\n          startScrollLeft - (e.clientX - startX);\n      });\n\n      window.addEventListener('pointerup', function() {\n        if (!isDragging) return;\n\n        isDragging = false;\n        paused = false;\n\n        let nearest = 0;\n        let distance = Infinity;\n\n        slides.forEach(function(slide, index) {\n          const left =\n            slide.offsetLeft - slides[0].offsetLeft;\n\n          const diff = Math.abs(\n            slider.scrollLeft - left\n          );\n\n          if (diff < distance) {\n            distance = diff;\n            nearest = index;\n          }\n        });\n\n        current = nearest;\n      });\n\n      slider.addEventListener('touchstart', function() {\n        paused = true;\n      }, { passive: true });\n\n      slider.addEventListener('touchend', function() {\n        setTimeout(function() {\n          paused = false;\n        }, 1500);\n      }, { passive: true });\n\n      document.addEventListener('visibilitychange', function() {\n        paused = document.hidden;\n      });\n\n      startAutoSlide();\n    });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener(\n      'DOMContentLoaded',\n      initAvivaSliders\n    );\n  } else {\n    initAvivaSliders();\n  }\n\n  document.addEventListener(\n    'shopify:section:load',\n    initAvivaSliders\n  );\n})();\n</script>"

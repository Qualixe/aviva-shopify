    "faq_HwtqLa": {
      "type": "faq",
      "blocks": {
        "faq_item_g8DxWd": {
          "type": "faq-item",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Most orders are dispatched within 1-2 business days and delivered within 3-5 business days, depending on your location. You'll receive a tracking link as soon as your gift ships.</p>"
          },
          "blocks": {}
        },
        "faq_item_CxM9Ck": {
          "type": "faq-item",
          "settings": {
            "question": "Can I customize my gift box?",
            "answer": "<p>Yes! You can mix and match items within a gift box, and add a personalized note at checkout. Select \"Buy It With\" add-ons on the product page to build a bundle that suits the occasion.</p>"
          },
          "blocks": {}
        },
        "faq_item_w6DUnV": {
          "type": "faq-item",
          "settings": {
            "question": "What is your return &amp; exchange policy?",
            "answer": "<p>Unused items in their original packaging can be returned or exchanged within 30 days of delivery. Personalized or engraved gifts are final sale unless damaged in transit.</p>"
          },
          "blocks": {}
        },
        "faq_item_KheWB8": {
          "type": "faq-item",
          "settings": {
            "question": "Do you offer international shipping?",
            "answer": "<p>We currently ship across the country with select international destinations available at checkout. Shipping fees and delivery times are calculated based on your address.</p>"
          },
          "blocks": {}
        },
        "faq_item_V9in6T": {
          "type": "faq-item",
          "settings": {
            "question": "How do I track my order?",
            "answer": "<p>Once your order ships, you'll receive an email and SMS with a tracking link. You can also check your order status anytime from your account dashboard.</p>"
          },
          "blocks": {}
        },
        "faq_item_f9EwLq": {
          "type": "faq-item",
          "settings": {
            "question": "What payment methods do you accept?",
            "answer": "<p>We accept all major credit and debit cards, mobile wallets, and cash on delivery in select areas. All online payments are processed securely at checkout.</p>"
          },
          "blocks": {}
        }

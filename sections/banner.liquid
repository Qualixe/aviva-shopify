{% liquid
    assign s = section.settings
%}
<section class="single-banner-section">
    <div class="container">
        <a href="{{ s.link }}" class="single-banner-wrap">
            <div class="img">
                {% if s.image != blank %}
                    {{ s.image | image_url: width: 2000 | image_tag: class: 'desktop-img', loading: 'lazy' }}
                {% else %}
                    {{ 'lifestyle-1' | placeholder_svg_tag: class: 'desktop-img' }}
                {% endif %}

                {% if s.image_mob != blank %}
                    {{ s.image_mob | image_url: width: 1000 | image_tag: class: 'mobile-img', loading: 'lazy' }}
                {% endif %}
            </div>
            {% if section.settings.title !=blank %}
            <div class="content">
                <h2 class="title">{{ s.title }}</h2>
            </div>
            {% endif %}
        </a>
    </div>
</section>

{% schema %}
{
    "name": "Single Banner",
    "settings": [
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "image_picker",
            "id": "image_mob",
            "label": "Image (Mobile)"
        },
        {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "premium bags"
        },
        {
            "type": "url",
            "id": "link",
            "label": "Link"
        }
    ],
    "presets": [
        {
            "name": "Single Banner"
        }
    ]
}
{% endschema %}
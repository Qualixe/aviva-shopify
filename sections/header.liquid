<header class="header" id="header_{{ section.id }}">
    <div class="container">
        <nav class="navbar">
            <div class="navbar-left">
                <button class="hamburger app-menu-open">
                    <svg class="header__nav-icon icon icon-hamburger" width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <mask id="mask0_5_1384" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="22" height="22">
                        <rect width="22" height="22" fill="#D9D9D9"></rect>
                        </mask>
                        <g mask="url(#mask0_5_1384)">
                        <path d="M1 18V15.8333H21V18H1ZM1 12.5833V10.4167H21V12.5833H1ZM1 7.16667V5H21V7.16667H1Z" fill="#3D3C3C" stroke="white" stroke-width="0.88"></path>
                        </g>
                    </svg>
                </button>
                <button class="navbar-icon navbar-search-open-btn">
                    <svg class="mobile-show-icon hide" width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <mask id="mask0_5_1381" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="22" height="22">
                    <rect width="22" height="22" fill="#0D485D"></rect>
                    </mask>
                    <g mask="url(#mask0_5_1381)">
                    <path d="M18.2167 19.5L12.4417 13.725C11.9833 14.0917 11.4563 14.3819 10.8604 14.5958C10.2646 14.8097 9.63056 14.9167 8.95833 14.9167C7.29306 14.9167 5.88368 14.3399 4.73021 13.1865C3.57674 12.033 3 10.6236 3 8.95833C3 7.29306 3.57674 5.88368 4.73021 4.73021C5.88368 3.57674 7.29306 3 8.95833 3C10.6236 3 12.033 3.57674 13.1865 4.73021C14.3399 5.88368 14.9167 7.29306 14.9167 8.95833C14.9167 9.63056 14.8097 10.2646 14.5958 10.8604C14.3819 11.4563 14.0917 11.9833 13.725 12.4417L19.5 18.2167L18.2167 19.5ZM8.95833 13.0833C10.1042 13.0833 11.0781 12.6823 11.8802 11.8802C12.6823 11.0781 13.0833 10.1042 13.0833 8.95833C13.0833 7.8125 12.6823 6.83854 11.8802 6.03646C11.0781 5.23438 10.1042 4.83333 8.95833 4.83333C7.8125 4.83333 6.83854 5.23438 6.03646 6.03646C5.23438 6.83854 4.83333 7.8125 4.83333 8.95833C4.83333 10.1042 5.23438 11.0781 6.03646 11.8802C6.83854 12.6823 7.8125 13.0833 8.95833 13.0833Z" fill="#3D3C3C" stroke="white" stroke-width="0.3"></path>
                    </g>
                    </svg>
                </button>
                
                <div class="navbar-logo">
                    {% content_for "block", type: "header-logo", id: "header-logo" %}
                </div>

                 <div class="navbar-center">
                    {% content_for "block", type: "header-search", id: "header-search" %}
                </div>
            </div>

            <div class="navbar-logo mobile_header_logo">
                {% content_for "block", type: "header-logo", id: "header-logo_2" %}
            </div>
           
            <!-- search-bar popup start -->
            {% content_for "block", type: "header-search-result", id: "header-search-result" %}
            <!-- search-bar popup end -->
            {% content_for "block", type: "header-icons", id: "header-icons" %}
            
            {% content_for "block", type: "header-nav", id: "header-nav" %}
        </nav>
    </div>

    <!-- mobile-menu start -->
    {% content_for "block", type: "mobile-menu", id: "mobile-menu" %}
    <!-- mobile-menu end -->
</header>

{% render 'colors-section', section: section %}

{% schema %}
    {
        "name": "Header",
        "enabled_on": {"groups": ["header"]},
        "settings": [
            {
                "type": "color",
                "id": "background",
                "label": "Background Color",
                "default": "{{ settings.color_palette.background }}"
            },
            {
                "type": "color",
                "id": "text",
                "label": "Text",
                "default": "{{ settings.color_palette.nav }}"
            }
        ],
        "blocks": [
            { "type": "header-logo" }, 
            { "type": "header-search"},
            { "type": "header-search-result"},
            { "type": "header-icons" },
            { "type": "header-nav" }
        ]
    }
{% endschema %}
<header class="header" id="header_{{ section.id }}">
    <div class="container">
        <nav class="navbar">
            <div class="navbar-left">
                <button class="hamburger app-menu-open">
                    <svg width="25" height="15" viewBox="0 0 25 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M0.5 13.8333H24.5M0.5 7.16667H24.5M0.5 0.5H24.5" stroke="#16415F" stroke-linecap="round"
                            stroke-linejoin="round"></path>
                    </svg>
                </button>
                <button class="navbar-icon navbar-search-open-btn">
                    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path
                            d="M9.16667 15.8333C12.8486 15.8333 15.8333 12.8486 15.8333 9.16667C15.8333 5.48477 12.8486 2.5 9.16667 2.5C5.48477 2.5 2.5 5.48477 2.5 9.16667C2.5 12.8486 5.48477 15.8333 9.16667 15.8333Z"
                            stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M17.5 17.5L13.875 13.875" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                            stroke-linejoin="round"></path>
                    </svg>
                </button>
                <div class="navbar-logo">
                    {% content_for "block", type: "header-logo", id: "header-logo" %}
                </div>
            </div>
            <div class="navbar-center">
                {% content_for "block", type: "header-search", id: "header-search" %}
                <div class="navbar-logo">
                    {% content_for "block", type: "header-logo", id: "header-logo_2" %}
                </div>
            </div>
            <!-- search-bar popup start -->
            {% content_for "block", type: "header-search-result", id: "header-search-result" %}
            <!-- search-bar popup end -->
            {% content_for "block", type: "header-icons", id: "header-icons" %}
            
            {% content_for "block", type: "header-nav", id: "header-nav" %}
        </nav>
    </div>

    <!-- mobile-menu start -->
    {% content_for "block", type: "mobile-menu", id: "mobile-menu" %}
    <!-- mobile-menu end -->
</header>

{% render 'colors-section', section: section %}

{% schema %}
    {
        "name": "Header",
        "tag": "header",
        "enabled_on": {"groups": ["header"]},
        "settings": [
            {
                "type": "color",
                "id": "background",
                "label": "Background Color",
                "default": "{{ settings.color_palette.background }}"
            },
            {
                "type": "color",
                "id": "text",
                "label": "Text",
                "default": "{{ settings.color_palette.nav }}"
            }
        ],
        "blocks": [
            { "type": "header-logo" }, 
            { "type": "header-search"},
            { "type": "header-search-result"},
            { "type": "header-icons" },
            { "type": "header-nav" }
        ]
    }
{% endschema %}
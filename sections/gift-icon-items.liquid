{{ 'gift-icon-items-section.css' | asset_url | stylesheet_tag }}

{% liquid
	assign s = section.settings
%}
<section class="gift-icon-items-section" dd style="background-color: {{ s.background_color }};">
	<div class="container">
		{% if s.title != blank %}
			<h2 class="gift-icon-items-title">{{ s.title }}</h2> 
		{% endif %}
		<div class="gift-icon-items">
			{% content_for 'blocks' %}
		</div>
		{% if s.show_flourish %}
			<div class="gift-icon-items-flourish">
				<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path d="M12 2c0 4-1 6-5 7 4 1 5 3 5 7 0-4 1-6 5-7-4-1-5-3-5-7z" fill="{{ settings.color_palette.gold }}"></path>
					<path d="M4 15c0 1.5-.5 2.2-2 2.5 1.5.3 2 1 2 2.5 0-1.5.5-2.2 2-2.5-1.5-.3-2-1-2-2.5z"
						fill="{{ settings.color_palette.gold }}"></path>
				</svg>
			</div>
		{% endif %}
	</div>
</section>

{% schema %}
{
	"name": "Gift Icon Items",
	"settings": [
		{
			"type": "text",
			"id": "title",
			"label": "Title",
			"default": "Our Kind of Gifting"
		},
		{
			"type": "checkbox",
			"id": "show_flourish",
			"label": "Show flourish icon",
			"default": true
		},
		{
			"type": "color",
			"id": "background_color",
			"label": "Background color",
			"default" : "#fff"
		}
	],
	"blocks": [
		{
			"type": "gift-icon-item"
		}
	],
	"presets": [
		{
			"name": "Gift Icon Items",
			"blocks": [
				{
					"type": "gift-icon-item",
					"settings": {
						"icon": "handcrafted",
						"title": "Thoughtful & handcrafted"
					}
				},
				{
					"type": "gift-icon-item",
					"settings": {
						"icon": "gift-box",
						"title": "Gift-worthy boxes"
					}
				},
				{
					"type": "gift-icon-item",
					"settings": {
						"icon": "india-design",
						"title": "India-inspired designs"
					}
				}
			]
		}
	]
}
{% endschema %}

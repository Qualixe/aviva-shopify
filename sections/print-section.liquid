<section class="shop-by-print-section section-bg">
    <div class="container">
        {% if section.settings.eyebrow != blank %}
            <p class="shop-by-print-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <div class="shop-by-print-items">
            {% content_for 'blocks' %}
        </div>
    </div>
</section> 

{% schema %}
{
    "name": "Shop By Print",
    "settings": [
        {
            "type": "text",
            "id": "eyebrow",
            "label": "Eyebrow",
            "default": "Shop by Print"
        }
    ],
    "blocks": [
        {
            "type": "shop-by-print-block"
        }
    ],
    "presets": [
        {
            "name": "Shop By Print"
        }
    ]
}
{% endschema %}

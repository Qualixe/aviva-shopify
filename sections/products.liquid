{% assign s = section.settings %}
<section class="section card-slider-section section-bg" id="section_{{ section.id }}">
    <div class="container">
        
        {% content_for 'block', type:'section-heading', id:'section-heading' %}
        <div class="swiper card-slider">
            <div class="swiper-wrapper">
                {% for product in section.settings.collection.products limit: s.limit %}
                <div class="swiper-slide">
                    <div class="card-slider-item">
                       {% render 'product', product: product %}
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

{% render 'colors-section', section: section %}

{% schema %}
{
    "name": "Products",
    "settings": [
        {
            "type": "collection",
            "id": "collection",
            "label": "Collection"
        },
        {
            "type": "range",
            "id": "limit",
            "label": "Limit",
            "min": 2,
            "max": 30,
            "step": 2,
            "default" : 12
        }
    ],
    "blocks": [
        {
            "type": "section-heading"
        }
    ],
    "presets": [
        {
            "name": "Products"
        }
    ]
}
{% endschema %}
{{ 'single-video-section.css' | asset_url | stylesheet_tag }}

{% liquid
	assign s = section.settings
%}
<section class="single-video-section">
    <div class="container">
        <div class="single-video-wrap">
            {% if s.video != blank %}
                {{ s.video | video_tag: class: 'single-video', image_size: '1100x', autoplay: s.autoplay, loop: s.loop, muted: s.muted, controls: s.controls, poster: s.poster }}
            {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag: class: 'single-video' }}
            {% endif %}
        </div>
    </div>
</section>

{% schema %}
{
    "name": "Single Video",
    "settings": [
        {
            "type": "video",
            "id": "video",
            "label": "Video"
        },
        {
            "type": "image_picker",
            "id": "poster",
            "label": "Poster image",
            "info": "Shown before the video loads/plays"
        },
        {
            "type": "checkbox",
            "id": "autoplay",
            "label": "Autoplay",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "loop",
            "label": "Loop",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "muted",
            "label": "Muted",
            "info": "Most browsers block autoplay unless the video is muted",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "controls",
            "label": "Show playback controls",
            "default": false
        }
    ],
    "presets": [
        {
            "name": "Single Video"
        }
    ]
}
{% endschema %}

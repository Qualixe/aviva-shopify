{% liquid
    assign has_results = false
    if search.performed and search.results_count > 0
        assign has_results = true
    endif

    if has_results
        assign source = search
        assign form_action = routes.search_url
        assign encoded_terms = search.terms | url_encode
        assign clear_url = routes.search_url | append: '?type=product&q=' | append: encoded_terms
        assign heading = 'content.search_results' | t
        assign per_page = section.settings.products_per_page
    else
        assign source = settings.empty_state_collection | default: collections.all
        assign form_action = source.url
        assign clear_url = source.url
        assign heading = section.settings.suggestions_heading
        assign per_page = section.settings.suggestions_count
    endif
%}
<section class="collection-section" data-section-id="{{ section.id }}">
    <div class="container">
        <div class="collection-wrapper">
            <form method="get" action="{{ form_action }}" id="{% if has_results %}CollectionFiltersForm{% else %}SuggestionFiltersForm{% endif %}">
                {% if has_results %}
                    <input type="hidden" name="type" value="product">
                    <input type="hidden" name="q" value="{{ search.terms | escape }}">
                {% endif %}
                {% render 'collection-filters', results: source, results_url: clear_url %}
                <div class="collection-content">
                    {% if has_results %}
                        {% paginate search.results by per_page %}
                            {% render 'search-results-grid', source: source, heading: heading, items: search.results, paginate: paginate, has_results: true %}
                        {% endpaginate %}
                    {% else %}
                        {% paginate source.products by per_page %}
                            {% render 'search-results-grid', source: source, heading: heading, items: source.products, paginate: paginate, has_results: false %}
                        {% endpaginate %}
                    {% endif %}
                </div>
            </form>
        </div>
    </div>
</section>

{% unless has_results %}
    <script>
        (function () {
            var form = document.getElementById('SuggestionFiltersForm');
            if (!form) return;
            var heading = {{ section.settings.suggestions_heading | json }};
            var base = {{ form_action | json }};

            function load(url) {
                var current = form.querySelector('.collection-content');
                if (!current) return;
                current.classList.add('loading');
                fetch(url)
                    .then(function (res) {
                        if (!res.ok) throw new Error('fetch failed');
                        return res.text();
                    })
                    .then(function (html) {
                        var next = new DOMParser().parseFromString(html, 'text/html').querySelector('.collection-content');
                        if (!next) throw new Error('content missing');
                        var title = next.querySelector('.collection-heading');
                        if (title) title.textContent = heading;
                        current.replaceWith(next);
                    })
                    .catch(function () {
                        window.location.href = url;
                    });
            }

            form.addEventListener('change', function (e) {
                if (!e.target.matches('.filter-option-input, .price-range-input, #sort_by')) return;
                e.stopPropagation();
                load(base + '?' + new URLSearchParams(new FormData(form)).toString());
            });

            form.addEventListener('click', function (e) {
                var link = e.target.closest('.pagination__link[href]');
                if (!link) return;
                e.preventDefault();
                e.stopPropagation();
                load(link.href);
            });
        })();
    </script>
{% endunless %}

<style>
    .collection-empty-state {
        grid-column: 1 / -1;
        width: 100%;
        text-align: center;
        padding: 60px 0;
        color: var(--paragraph-text-color);
    }
    .collection-top {
        background: {{ section.settings.top_bg }};
        border-color: {{ section.settings.border }};
    }
    .collection-content.loading {
        opacity: 0.5;
        pointer-events: none;
        transition: opacity 0.15s ease;
    }
</style>

{% schema %}
{
    "name": "t:names.search_results",
    "settings": [
        {
            "type": "text",
            "id": "suggestions_heading",
            "label": "No results heading",
            "default": "You may also like"
        },
        {
            "type": "range",
            "id": "suggestions_count",
            "label": "Suggested products",
            "min": 4,
            "max": 24,
            "step": 4,
            "default": 8
        },
        {
            "type": "range",
            "id": "products_per_page",
            "label": "Products Per Page",
            "min": 8,
            "max": 48,
            "step": 4,
            "default": 24
        },
        {
            "type": "color",
            "id": "top_bg",
            "label": "Top Background",
            "default": "{{ settings.color_palette.section_bg }}"
        },
        {
            "type": "color",
            "id": "border",
            "label": "Border",
            "default": "{{ settings.color_palette.border }}"
        }
    ]
}
{% endschema %}

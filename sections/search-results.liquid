{% capture clear_url %}{{ routes.search_url }}?type=product&q={{ search.terms | url_encode }}{% endcapture %}

<section class="collection-section" data-section-id="{{ section.id }}">
    <div class="container">
        <div class="collection-wrapper">
            <form method="get" action="{{ routes.search_url }}" id="CollectionFiltersForm">
                <input type="hidden" name="type" value="product">
                <input type="hidden" name="q" value="{{ search.terms | escape }}">
                {% if search.performed and search.results_count > 0 %}
                    {% render 'collection-filters', results: search, results_url: clear_url %}
                {% endif %}
                <div class="collection-content">
                    {% if search.performed and search.results_count > 0 %}
                        {% paginate search.results by section.settings.products_per_page %}
                            <div class="collection-top">
                                <h2 class="collection-heading">{{ 'content.search_results' | t }}</h2>
                                <div class="collection-filter-btn">
                                    <div class="collection-filter-short">
                                        <p class="collection-product-count">{{ search.results_count }} products</p>
                                        <div class="filter-select-field">
                                            <select name="sort_by" id="sort_by">
                                                {% for option in search.sort_options %}
                                                    <option value="{{ option.value }}" {% if option.value == search.sort_by %}selected{% endif %}>{{ option.name }}</option>
                                                {% endfor %}
                                            </select>
                                            <span class="filter-select-field-icon">
                                                <svg aria-hidden="true" focusable="false" class="icon icon-caret" viewBox="0 0 10 6">
                                                    <path fill-rule="evenodd" clip-rule="evenodd"
                                                        d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z"
                                                        fill="currentColor">
                                                    </path>
                                                </svg>
                                            </span>
                                        </div>
                                    </div>
                                    <span class="filter-open-btn">
                                        <svg width="15" height="14" viewBox="0 0 15 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path
                                                d="M0.375 1.35419C0.375 1.35419 2.33337 0.375 7.22931 0.375C12.1252 0.375 14.0836 1.35419 14.0836 1.35419L8.69809 7.7189V12.1252L5.76053 13.594V7.7189L0.375 1.35419Z"
                                                stroke="#fff" stroke-width="0.75" stroke-linecap="round" stroke-linejoin="round"></path>
                                        </svg>
                                        Filter
                                    </span>
                                </div>
                            </div>
                            <div class="product-items">
                                {% for item in search.results %}
                                    {% if item.object_type == 'product' %}
                                        <div class="product-item">
                                            {% render 'product', product: item %}
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            </div>
                            {% render 'pagination-controls', paginate: paginate %}
                        {% endpaginate %}
                    {% else %}
                        {% assign suggestions = settings.empty_state_collection | default: collections.all %}
                        <div class="collection-top">
                            <h2 class="collection-heading">{{ section.settings.suggestions_heading }}</h2>
                        </div>
                        <div class="product-items">
                            {% for product in suggestions.products limit: section.settings.suggestions_count %}
                                <div class="product-item">
                                    {% render 'product', product: product %}
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </form>
        </div>
    </div>
</section>

<style>
    .collection-empty-state {
        grid-column: 1 / -1;
        width: 100%;
        text-align: center;
        padding: 60px 0;
        color: var(--paragraph-text-color);
    }
    .collection-top {
        background: {{ section.settings.top_bg }};
        border-color: {{ section.settings.border }};
    }
    .collection-content.loading {
        opacity: 0.5;
        pointer-events: none;
        transition: opacity 0.15s ease;
    }
</style>

{% schema %}
{
    "name": "t:names.search_results",
    "settings": [
        {
            "type": "text",
            "id": "suggestions_heading",
            "label": "No results heading",
            "default": "You may also like"
        },
        {
            "type": "range",
            "id": "suggestions_count",
            "label": "Suggested products",
            "min": 4,
            "max": 24,
            "step": 4,
            "default": 8
        },
        {
            "type": "range",
            "id": "products_per_page",
            "label": "Products Per Page",
            "min": 8,
            "max": 48,
            "step": 4,
            "default": 24
        },
        {
            "type": "color",
            "id": "top_bg",
            "label": "Top Background",
            "default": "{{ settings.color_palette.section_bg }}"
        },
        {
            "type": "color",
            "id": "border",
            "label": "Border",
            "default": "{{ settings.color_palette.border }}"
        }
    ]
}
{% endschema %}

<div class="category-section mobile-category">
    <div class="container">
        <div class="category-wrapper">
            <div class="category-slider-wrapper">
                <div class="swiper category-slider">
                    <div class="swiper-wrapper">
                        {% for block in section.blocks %}
                        {% assign b = block.settings %}
                        <div class="swiper-slide">
                            <a href="{{ b.link |  default:'collections/all' }}" class="category-item">
                                <div class="img">
                                    {% if b.image !=blank %}
                                        {{ b.image | image_url: width: 1000 | image_tag: class:'category_img' }}
                                    {% else %}
                                        {{ 'image' |  placeholder_svg_tag:'svg_icon category_svg' }}
                                    {% endif %}
                                </div>
                                <div class="content">
                                    <p class="title">{{ b.title }}</p>
                                </div>
                            </a>
                        </div>
                        {% endfor %}
                    </div>
                    <div class="swiper-button-prev category-button-prev"></div>
                    <div class="swiper-button-next category-button-next"></div>
                </div>
            </div>
        </div>
    </div>
</div>

{% schema %}
{
    "name": "Category(Mobile)",
    "settings": [
        
    ],
    "blocks": [
        {
            "type": "Category",
            "name": "Category",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
                {
                    "type": "text",
                    "id": "title",
                    "label": "Title",
                    "default": "Category"
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "Link"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Category(Mobile)"
        }
    ]
}
{% endschema %}
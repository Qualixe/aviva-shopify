{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign save_percentage = 0
  if current_variant.compare_at_price > current_variant.price
    assign save_percentage = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
  endif

  assign preorder = false
  for tag in product.tags
    if tag contains 'preorder'
      assign preorder = true
    else 
      assign preorder = false
    endif
  endfor
%}

<section
  class="sticky-add-to-cart-section"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
  data-current-variant-id="{{ current_variant.id }}"
  data-variant-available="{{ current_variant.available }}"
  {{ block.shopify_attributes }}
>
  <div class="sticky-add-to-cart-left">
    <div class="sticky-prduct-img">
      {% assign sticky_image = current_variant.featured_image | default: product.featured_image %}
      {% if sticky_image != blank %}
        <img
          src="{{ sticky_image | image_url: width: 200 }}"
          alt="{{ sticky_image.alt | default: product.title | escape }}"
          width="80"
          height="80"
          loading="lazy" 
        >
      {% endif %}
    </div>

    <div class="sticky-prduct-content">
      <p class="sticky-add-to-cart-title">{{ product.title }}</p>
      <div class="sticky-prduct-price">
        <div class="card-price-wrap">
          <p class="latest-price" data-sticky-price>{{ current_variant.price | money_without_trailing_zeros }}</p>

          {% if current_variant.compare_at_price > current_variant.price %}
            <p class="previous-price" data-sticky-compare-price>{{ current_variant.compare_at_price | money_without_trailing_zeros }}</p>
            <p class="product-price-save" data-sticky-save>{{ save_percentage }}% OFF</p>
          {% else %}
            <p class="previous-price" data-sticky-compare-price hidden></p>
            <p class="product-price-save" data-sticky-save hidden></p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <div class="sticky-add-to-cart-right">
    <div class="sticky-bar-btn-wrap">
      <button
        class="btn sticky-add-to-cart-button"
        type="button"
        data-variant-id="{{ current_variant.id }}"
        data-qty="1"
        {% unless current_variant.available %}disabled{% endunless %}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="20" r="1"></circle>
          <circle cx="18" cy="20" r="1"></circle>
          <path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 1.9-1.4L21 8H6"></path>
        </svg>
        <span class="sticky-add-to-cart-label">
            {% if preorder %}
                {% if current_variant.available !=true %}
                    Soldout
                {% elsif preorder %}
                    Pre Order
                {% endif %}
            {% else %}
                {% if current_variant.available %}
                    Add To Cart
                {% else %}
                    Sold Out
                {% endif %}
            {% endif %}
        </span>
      </button>
    </div>
  </div>
</section>

<script>
  (function () {
    const section = document.currentScript && document.currentScript.previousElementSibling;
    if (!section) return;

    const button = section.querySelector('.sticky-add-to-cart-button');
    const priceEl = section.querySelector('[data-sticky-price]');
    const comparePriceEl = section.querySelector('[data-sticky-compare-price]');
    const saveEl = section.querySelector('[data-sticky-save]');
    const priceLabel = button?.querySelector('.sticky-add-to-cart-label');

    // The product page's own form (blocks/atc.liquid) is the source of
    // truth for the selected variant, quantity and "buy it with" items, so
    // clicking here just submits that form through its add-to-cart button.
    // Its submit handler in assets/script.js does the /cart/add.js call and
    // opens the cart drawer.
    function getMainForm() {
      return document.querySelector('.product-add-to-cart-form');
    }

    button?.addEventListener('click', function () {
      const form = getMainForm();
      const mainButton = form?.querySelector('.atc-btn');
      if (!form || !mainButton || mainButton.disabled) return;
      form.requestSubmit(mainButton);
    });

    // The sticky bar has no variant picker of its own; it only mirrors the
    // main form's variant id, availability and price onto its own markup.
    function syncFromMainForm() {
      const form = getMainForm();
      const variantInput = form?.querySelector('.product-form-variant-id');
      const mainButton = form?.querySelector('.atc-btn');

      if (button && variantInput && mainButton) {
        button.dataset.variantId = variantInput.value || '';
        button.disabled = !variantInput.value || mainButton.disabled;

        if (priceLabel) {
          priceLabel.textContent = button.disabled ? 'Sold out' : 'Add To Cart';
        }
      }

      const priceWrap = document.querySelector('.product-price-wrap');
      const mainPriceEl = priceWrap?.querySelector('.latest-price');
      const mainComparePriceEl = priceWrap?.querySelector('.previous-price');
      const mainSaveEl = priceWrap?.querySelector('.product-price-save');

      if (priceEl && mainPriceEl) {
        priceEl.textContent = mainPriceEl.textContent;
      }
      if (comparePriceEl && mainComparePriceEl) {
        comparePriceEl.hidden = mainComparePriceEl.hidden;
        comparePriceEl.textContent = mainComparePriceEl.textContent;
      }
      if (saveEl && mainSaveEl) {
        saveEl.hidden = mainSaveEl.hidden;
        saveEl.textContent = mainSaveEl.textContent;
      }
    }

    // The main variant picker's listener (assets/script.js) is bound on its
    // options wrapper and runs first during bubbling, so by the time this
    // document-level handler fires the main form's variant id / price DOM
    // is already updated.
    document.addEventListener('change', function (event) {
      const target = event.target;
      if (target instanceof Element && target.classList.contains('product-varient-input')) {
        syncFromMainForm();
      }
    });

    syncFromMainForm();
  })();
</script>

{% schema %}
{
  "name": "Product sticky",
  "enabled_on": {"templates": ["product"]},
  "settings": [],
  "presets": [
    {
      "name": "Product sticky",
      "category": "Product"  
    } 
  ]
}
{% endschema %}

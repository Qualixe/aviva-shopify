{% assign b = block.settings %}
{% capture blocks_html %}{% content_for "blocks" %}{% endcapture %}
<div class="mobile-menu-wrap">
    <div class="mobile-menu-close-window-btn"></div>
    <div class="mobile-menu-container">
        <div class="mobile-menu-container-top">
            <button class="mobile-menu-close-btn" type="button">
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M16 10H4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                    <path d="M8 6L4 10L8 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                        stroke-linejoin="round"></path>
                </svg>
            </button>
            <a href="{{ shop.url }}" class="mobile-menu-logo">
                {% if b.logo !=blank %}
                    {{ b.logo |  image_url: width: 500 |  image_tag: class: 'mobile_menu_logo'  }}
                {% endif %}
            </a>
        </div>
        <div class="mobile-nav-items">
            {% for link in b.menu.links %}
                {% liquid
                    assign link_handle = link.title | handleize
                    assign mega_marker = 'data-mega-menu="' | append: link_handle | append: '"'
                    assign has_mega = false
                    if blocks_html contains mega_marker
                        assign has_mega = true
                    endif
                %}
            <div class="mobile-nav-item" data-nav-link="{{ link_handle }}">
                {% if link.links.size > 0 or has_mega %}
                    <div class="mobile-nav-item-heading">
                        <p class="title">{{ link.title }}</p>
                        <span class="icon">
                            <svg aria-hidden="true" focusable="false" fill="none" width="12" viewBox="0 0 10 10">
                                <path d="m3 9 4-4-4-4" stroke="currentColor" stroke-linecap="square"></path>
                            </svg>
                        </span>
                    </div>
                    <div class="mobile-nav-item-content">
                        <div class="mobile-menu-top">
                            <button class="mobile-menu-close-btn" type="button">
                                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                                    <path d="M16 10H4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                                    <path d="M8 6L4 10L8 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                                        stroke-linejoin="round"></path>
                                </svg>
                            </button>
                            <p class="mobile-menu-title">{{ link.title }}</p>
                        </div>
                        {% if link.links.size > 0 %}
                        <ul class="mobile-nav-sublist">
                            {% for childlink in link.links %}
                                <li><a href="{{ childlink.url }}">{{ childlink.title }}</a></li>
                            {% endfor %}
                        </ul>
                        {% endif %}
                    </div>
                {% else %}
                    <a href="{{ link.url }}" class="mobile-nav-item-heading">
                        <p class="title">{{ link.title }}</p>
                    </a>
                {% endif %}
            </div>

            {% endfor %}
            
        </div>
    </div>
</div>


<div class="mobile-items-source" hidden>
    {{ blocks_html }}
</div>

{% schema %}
{
    "name": "Mobile Menu",
    "settings": [
        {
            "type": "image_picker",
            "id": "logo",
            "label": "Logo"
        },
        {
            "type": "link_list",
            "id": "menu",
            "label": "Menu",
            "default" : "main-menu"
        }
    ],
    "blocks": [
        {
            "type": "mobile-menu-item"
        }
    ],
    "presets": [
        {
            "name": "Mobile Menu"
        }
    ]
} 
{% endschema %}
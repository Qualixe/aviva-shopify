{% liquid
    assign s = block.settings
%}
<div class="see-what-fits-item" {{ block.shopify_attributes }}>
    <span class="icon">
        {% case s.icon %}
            {% when 'wallet' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                    stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="6" width="18" height="13" rx="2"></rect>
                    <path d="M3 10h18"></path>
                    <circle cx="16" cy="14" r="1.1" fill="currentColor" stroke="none"></circle>
                </svg>
            {% when 'cosmetics' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                    stroke-linejoin="round" aria-hidden="true">
                    <rect x="5" y="9" width="14" height="11" rx="3"></rect>
                    <path d="M7 9V7a5 5 0 0 1 10 0v2"></path>
                </svg>
            {% when 'keys' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                    stroke-linejoin="round" aria-hidden="true">
                    <circle cx="8" cy="8" r="4"></circle>
                    <path d="M11 11l9 9M17 17l2-2M15 19l2-2"></path>
                </svg>
            {% when 'earbuds' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                    stroke-linejoin="round" aria-hidden="true">
                    <rect x="4" y="8" width="16" height="11" rx="4"></rect>
                    <path d="M4 12h16"></path>
                    <circle cx="9" cy="10" r="1" fill="currentColor" stroke="none"></circle>
                    <circle cx="15" cy="10" r="1" fill="currentColor" stroke="none"></circle>
                </svg>
            {% when 'phone' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                    stroke-linejoin="round" aria-hidden="true">
                    <rect x="7" y="3" width="10" height="18" rx="2"></rect>
                    <path d="M11 18h2"></path>
                </svg>
            {% when 'bottle' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                    stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 3h6v3.5l1.5 2V21a1 1 0 0 1-1 1h-6a1 1 0 0 1-1-1V8.5L9 6.5V3Z"></path>
                    <path d="M9 11h6"></path>
                </svg>
            {% when 'umbrella' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                    stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 3a9 9 0 0 1 9 9H3a9 9 0 0 1 9-9Z"></path>
                    <path d="M12 12v7a2 2 0 0 1-4 0"></path>
                    <path d="M12 3v1"></path>
                </svg>
        {% endcase %}
    </span>
    <p>{{ s.label }}</p>
</div>

{% schema %}
{
    "name": "See What Fits Item",
    "settings": [
        {
            "type": "select",
            "id": "icon",
            "label": "Icon",
            "options": [
                { "value": "wallet", "label": "Wallet" },
                { "value": "cosmetics", "label": "Cosmetics" },
                { "value": "keys", "label": "Keys" },
                { "value": "earbuds", "label": "Earbuds" },
                { "value": "phone", "label": "Phone" },
                { "value": "bottle", "label": "Bottle" },
                { "value": "umbrella", "label": "Umbrella" }
            ],
            "default": "wallet"
        },
        {
            "type": "text",
            "id": "label",
            "label": "Label",
            "default": "Wallet"
        }
    ],
    "presets": [
        {
            "name": "See What Fits Item"
        }
    ]
}
{% endschema %}

<div class="swiper-slide" {{ block.shopify_attributes }}>
    <a href="{{ block.settings.collection.url | default: '#!' }}" class="featured-collection-item">
        <div class="featured-collection-item-img">
            {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1000 | image_tag: class: 'featured-collection-img', loading: 'lazy' }}
            {% elsif block.settings.collection.featured_image != blank %}
                {{ block.settings.collection.featured_image | image_url: width: 1000 | image_tag: class: 'featured-collection-img', loading: 'lazy' }}
            {% else %}
                {{ 'collection-1' | placeholder_svg_tag: class: 'featured-collection-img' }}
            {% endif %}
        </div>
        <div class="featured-collection-item-content">
            <h3 class="title">{{ block.settings.heading | default: block.settings.collection.title }}</h3>
            <span class="explore-link">{{ block.settings.button_label }}</span>
        </div>
    </a>
</div>

{% schema %}
{
    "name": "Featured Collection Item",
    "settings": [
        {
            "type": "collection",
            "id": "collection",
            "label": "Collection"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image",
            "info": "Overrides the collection's featured image"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "info": "Overrides the collection title"
        },
        {
            "type": "text",
            "id": "button_label",
            "label": "Button Label",
            "default": "Explore Now"
        }
    ],
    "presets": [
        {
            "name": "Featured Collection Item"
        }
    ]
}
{% endschema %}

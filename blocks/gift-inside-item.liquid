{% assign b = block.settings %}
<a href="{{ b.link | default: '#' }}" class="gift-by-inside-item">
    <div class="gift-by-inside-img">
        {% if b.image != blank %}
            {{ b.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: b.title }}
        {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
        {% endif %}
    </div>
    {% if b.title != blank %}
        <p class="gift-by-inside-name">{{ b.title }}</p>
    {% endif %}
</a>

{% schema %}
{
    "name": "Gift Inside Item",
    "settings": [
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Sling Bags"
        },
        {
            "type": "url",
            "id": "link",
            "label": "Link"
        }
    ],
    "presets": [
        {
            "name": "Gift Inside Item"
        }
    ]
}
{% endschema %}

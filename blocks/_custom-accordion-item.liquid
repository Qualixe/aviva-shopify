{%- assign s = block.settings -%}
{%- comment -%} Hidden on the live store when there is no text; always shown in the editor. {%- endcomment -%}
{%- if s.content != blank or request.design_mode -%}
  <details class="custom-accordion-item"{% if s.open %} open{% endif %} {{ block.shopify_attributes }}>
    <summary class="custom-accordion-item__summary">
      {%- if s.icon_image != blank -%}
        {{ s.icon_image | image_url: width: 60 | image_tag: class: 'custom-accordion-item__icon-image', alt: '', loading: 'lazy' }}
      {%- endif -%}
      <span class="custom-accordion-item__title">{{ s.title | default: 'Accordion item' }}</span>
      <span class="custom-accordion-item__arrow" aria-hidden="true">
        <svg viewBox="0 0 10 6" focusable="false">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"/>
        </svg>
      </span>
    </summary>
    <div class="custom-accordion-item__content">
      {{ s.content }}
    </div>
  </details>
{%- endif -%}

{% schema %}
{
  "name": "Accordion Item",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Accordion item"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Icon (optional)"
    },
    {
      "type": "checkbox",
      "id": "open",
      "label": "Open by default",
      "default": false
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Add your content here.</p>"
    }
  ],
  "presets": [
    {
      "name": "Accordion Item"
    }
  ]
}
{% endschema %}

{% liquid
	assign s = block.settings
%}
<div class="gift-icon-item" {{ block.shopify_attributes }} id="block_{{ block.id }}">
	<span class="gift-icon-item-circle">
		{% case s.icon %}
			{% when 'handcrafted' %}
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" fill="none">
					<g stroke="#C99F52" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round">
						<path d="M27 72c4-6 10-10 17-10h16c4 0 7 3 7 7s-3 7-7 7H47"></path>
						<path d="M60 76h14l13-8c5-3 10-1 12 3 2 4 0 8-4 10l-22 13c-4 2-8 3-13 3H43c-5 0-9-2-12-5l-7-7"></path>
						<path d="M42 62c-2-8 2-16 9-18 6-2 12 1 15 6"></path>
						<path d="M67 50c2-6 8-10 14-9 7 1 11 7 10 14"></path>
						<path
							d="M57 34c-1-6 3-11 9-12 6-1 11 3 12 9 1-6 6-10 12-9 6 1 10 6 9 12-2 10-12 15-21 21-9-6-19-11-21-21z">
						</path>
					</g>
				</svg>
			{% when 'gift-box' %}
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" fill="none">
					<g stroke="#C99F52" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round">
						<path d="M25 47h78v55H25z" />
						<path d="M22 47h84v16H22z" />
						<path d="M64 47v55" />
						<path d="M64 47H48c-8 0-13-4-13-10 0-5 4-9 9-9 10 0 20 9 20 19z" />
						<path d="M64 47h16c8 0 13-4 13-10 0-5-4-9-9-9-10 0-20 9-20 19z" />
						<path d="M64 27v20" />
					</g>
				</svg>
			{% when 'india-design' %}
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" fill="none">
					<g stroke="#C99F52" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round">
						<path
							d="M64 93c-17 0-31-8-31-18 0-8 8-15 19-18 1 10 5 18 12 24 7-6 11-14 12-24 11 3 19 10 19 18 0 10-14 18-31 18z" />
						<path d="M64 81c-9-8-14-19-14-31 0-10 6-19 14-26 8 7 14 16 14 26 0 12-5 23-14 31z" />
						<path d="M50 72c-10-2-19-7-24-15 8-2 16-1 23 3" />
						<path d="M78 72c10-2 19-7 24-15-8-2-16-1-23 3" />
						<path d="M43 90h42" />
					</g>
				</svg>
			{% when 'custom' %}
				{% if s.custom_icon != blank %}
					{{ s.custom_icon | image_url: width: 500 | image_tag: loading: 'lazy', alt: s.title }}
				{% else %}
					{{ 'image' | placeholder_svg_tag }}
				{% endif %}
		{% endcase %}
	</span>
	<h3 class="gift-icon-item-title">{{ s.title }}</h3>
</div>

{% schema %}
{
	"name": "Gift Icon Item",
	"settings": [
		{
			"type": "select",
			"id": "icon",
			"label": "Icon",
			"options": [
				{ "value": "handcrafted", "label": "Handcrafted" },
				{ "value": "gift-box", "label": "Gift box" },
				{ "value": "india-design", "label": "India-inspired design" },
				{ "value": "custom", "label": "Custom (upload image)" }
			],
			"default": "handcrafted"
		},
		{
			"type": "image_picker",
			"id": "custom_icon",
			"label": "Custom icon image",
			"info": "Only used when Icon is set to Custom",
			"visible_if": "{{ block.settings.icon == 'custom' }}"
		},
		{
			"type": "text",
			"id": "title",
			"label": "Title",
			"default": "Thoughtful & handcrafted"
		}
	],
	"presets": [
		{
			"name": "Gift Icon Item"
		}
	]
}
{% endschema %}

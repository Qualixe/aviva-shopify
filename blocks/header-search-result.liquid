{% liquid
    assign s = block.settings
%}
<button class="search-bar-window-cls-btn"></button>
<div class="search-bar" data-money-format="{{ shop.money_format | strip_html }}">
    <div class="search-bar-top">
        <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
            <div class="search-field">
                <span class="icon">
                    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path
                            d="M7.33333 12.6667C10.2789 12.6667 12.6667 10.2789 12.6667 7.33333C12.6667 4.38781 10.2789 2 7.33333 2C4.38781 2 2 4.38781 2 7.33333C2 10.2789 4.38781 12.6667 7.33333 12.6667Z"
                            stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        </path>
                        <path d="M14 14L11.1 11.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                            stroke-linejoin="round"></path>
                    </svg>
                </span>
                <input type="text" name="q" autocomplete="off" placeholder="Search">
            </div>
        </form>
        <button class="search-bar-close">
            <svg width="16" height="16" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path
                    d="M9.85403 9.14653C9.90048 9.19298 9.93733 9.24813 9.96247 9.30883C9.98762 9.36953 10.0006 9.43458 10.0006 9.50028C10.0006 9.56598 9.98762 9.63103 9.96247 9.69173C9.93733 9.75242 9.90048 9.80757 9.85403 9.85403C9.80757 9.90048 9.75242 9.93733 9.69173 9.96247C9.63103 9.98762 9.56598 10.0006 9.50028 10.0006C9.43458 10.0006 9.36953 9.98762 9.30883 9.96247C9.24813 9.93733 9.19298 9.90048 9.14653 9.85403L5.00028 5.70715L0.854028 9.85403C0.760208 9.94785 0.63296 10.0006 0.500278 10.0006C0.367596 10.0006 0.240348 9.94785 0.146528 9.85403C0.0527077 9.76021 2.61548e-09 9.63296 0 9.50028C-2.61548e-09 9.3676 0.0527077 9.24035 0.146528 9.14653L4.2934 5.00028L0.146528 0.854028C0.0527077 0.760208 0 0.63296 0 0.500278C0 0.367596 0.0527077 0.240348 0.146528 0.146528C0.240348 0.0527077 0.367596 0 0.500278 0C0.63296 0 0.760208 0.0527077 0.854028 0.146528L5.00028 4.2934L9.14653 0.146528C9.24035 0.0527077 9.3676 -2.61548e-09 9.50028 0C9.63296 2.61548e-09 9.76021 0.0527077 9.85403 0.146528C9.94785 0.240348 10.0006 0.367596 10.0006 0.500278C10.0006 0.63296 9.94785 0.760208 9.85403 0.854028L5.70715 5.00028L9.85403 9.14653Z"
                    fill="#0B0802"></path>
            </svg>
        </button>
    </div>
    <div class="search-bar-btm">
        <div class="search-history">
            <div class="search-history-items">
                <div class="search-history-item">
                    <p class="search-history-item-title">{{ s.popular_tags_title }}</p>
                    <div class="search-tags">
                        {% content_for 'blocks' %}
                    </div>
                </div>
                {% if s.recommended_collection.products.size > 0 %}
                    <div class="search-history-item">
                        <p class="search-history-item-title">{{ s.recommended_title }}</p>
                        <div class="swiper search-recommended-slider">
                            <div class="swiper-wrapper">
                                {% for product in s.recommended_collection.products limit: 8 %}
                                    <div class="swiper-slide">
                                        {% render 'product', product: product %}
                                    </div>
                                {% endfor %}
                            </div>
                            <div class="swiper-button-next search-recommended-slider-btn-next"></div>
                            <div class="swiper-button-prev search-recommended-slider-btn-prev"></div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
        <div class="search-result-area">
            <div class="search-result">
                <p class="search-result-title">Search Results:</p>
                <div class="search-result-items"></div>
                <div class="search-result-btn">
                    <a href="{{ routes.search_url }}" class="btn">view all results</a>
                </div>
            </div>
        </div>
    </div>
</div>

{% schema %}
{
    "name": "Search Result",
    "class": "search-bar-wrap",
    "settings": [
        {
            "type": "text",
            "id": "popular_tags_title",
            "label": "Popular Tags Title",
            "default": "most searched"
        },
        {
            "type": "collection",
            "id": "recommended_collection",
            "label": "Recommended Products Collection"
        },
        {
            "type": "text",
            "id": "recommended_title",
            "label": "Recommended Products Title",
            "default": "Recommended for you"
        }
    ],
    "blocks": [
        {
            "type": "search-tag"
        }
    ],
    "presets": [
        {
            "name": "Search Result",
            "category": "Header",
            "blocks": [
                { "type": "search-tag", "settings": { "label": "Wall paintings" } },
                { "type": "search-tag", "settings": { "label": "Bedsheets" } },
                { "type": "search-tag", "settings": { "label": "Rugs & Carpets" } },
                { "type": "search-tag", "settings": { "label": "Storage & Organization" } },
                { "type": "search-tag", "settings": { "label": "Lamps and lightings" } }
            ]
        }
    ]
}
{% endschema %}

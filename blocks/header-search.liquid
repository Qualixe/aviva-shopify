{% assign b = block.settings %}
{% assign texts = b.text | split: "--" %}

<div class="navbar-search">
    <button class="search-open navbar-search-open-btn">
        <span class="icon">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9.79526 16.03C13.2384 16.03 16.0296 13.2388 16.0296 9.79565C16.0296 6.3525 13.2384 3.56128 9.79526 3.56128C6.35211 3.56128 3.56088 6.3525 3.56088 9.79565C3.56088 13.2388 6.35211 16.03 9.79526 16.03Z" stroke="#8A8A8A" stroke-width="1.69219"></path>
                <path d="M18.7038 18.7041L15.1413 15.1416" stroke="#8A8A8A" stroke-width="1.69219"></path>
            </svg>
        </span>
        <span class="text p">
            search for
            <span class="search-roller">
                <span class="search-roller-track">
                    {% for text in texts %}
                        <span>{{ text }}</span>
                    {% endfor %}
                </span>
            </span>
        </span>
    </button>
</div>


{% schema %}
    {
        "name": "Header Search",
        "settings": [
            {
                "type": "textarea",
                "id": "text",
                "label": "Text",
                "default": "smart phone --home decoration -- gadgets"
            }
        ],
        "presets": [
            {
                "name": "Header Search",
                "category": "Header"
                
            }
        ]
    }
{% endschema %}
{% liquid
    assign product = closest.product
    if request.visual_preview_mode and product == blank
        assign product = collections.all.products.first
    endif
    assign variant = product.selected_or_first_available_variant
    assign qty_min = variant.quantity_rule.min | default: 1
    assign qty_step = variant.quantity_rule.increment | default: 1
%}
<div class="product-quantity-wrap" {{ block.shopify_attributes }}>
    <h2 class="product-quantity-title">Quantity:</h2>
    <div class="product-quantity">
        <button class="quantity-decrease" type="button" aria-label="decrease quantity">
            <svg width="11" height="2" viewBox="0 0 11 2" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0.75 0.75H10.0833" stroke="#666666" stroke-width="1.5" stroke-linecap="round"
                    stroke-linejoin="round"></path>
            </svg>
        </button>
        <input
            class="quantity-count"
            value="{{ qty_min }}"
            type="number"
            name="quantity"
            min="{{ qty_min }}"
            {% if variant.quantity_rule.max %}max="{{ variant.quantity_rule.max }}"{% endif %}
            step="{{ qty_step }}"
            aria-label="Quantity input"
        >
        <button class="quantity-increase" type="button" aria-label="increase quantity">
            <svg width="11" height="11" viewBox="0 0 11 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0.75 5.41667H10.0833M5.41667 0.75V10.0833V0.75Z" stroke="#1A1A1A" stroke-width="1.5"
                    stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
        </button>
    </div>
</div>

{% schema %}
{
    "name": "Product Quantity",
    "settings": [],
    "presets": [
        {
            "name": "Product Quantity"
        }
    ]
}
{% endschema %}

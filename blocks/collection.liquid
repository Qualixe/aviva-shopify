<div class="slide-item">
    <a href="{{ block.settings.collection.url }}" class="category-grid-item">
        <div class="img">
            {% if block.settings.image != blank %}
               {{ block.settings.image | image_url: width: 1000, height: 1000, crop: 'center' | image_tag: class: 'collection_img' }}
            {% else %}
                {{ 'image' | placeholder_svg_tag: width: 1000, height: 1000, class: 'svg_icon collection_img' }}
            {% endif %}
        </div>
        <div class="content">
            <h3 class="title">{{ block.settings.heading }}</h3>
            <span class="icon">
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M16 10H4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                    <path d="M8 6L4 10L8 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                        stroke-linejoin="round"></path>
                </svg>
            </span>
        </div>
    </a>
</div>

{% schema %}
{
    "name": "Collection",
    "class": "swiper-slide",
    "settings": [
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image" 
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Amaila daypack"    
        },
        {
            "type": "collection",
            "id": "collection",
            "label": "Collection"  
        }
    ],
    "presets": [
        {
            "name": "Collection"
        }
    ]
}
{% endschema %}
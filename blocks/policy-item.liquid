<div
	class="{% if block.settings.level == 'sub' %}policy-content-inner-item{% else %}policy-content-item{% endif %}"
	{{ block.shopify_attributes }}
>
	{% if block.settings.title != blank %}
		{% if block.settings.level == 'sub' %}
			<h3 class="policy-content-item-title">{{ block.settings.title }}</h3>
		{% else %}
			<h2 class="policy-content-item-title">{{ block.settings.title }}</h2>
		{% endif %}
	{% endif %}
	{% if block.settings.content != blank %}
		<div class="policy-content-text">{{ block.settings.content }}</div>
	{% endif %}
</div>

{% schema %}
{
	"name": "Policy Item",
	"settings": [
		{
			"type": "select",
			"id": "level",
			"label": "Level",
			"options": [
				{ "value": "main", "label": "Main section" },
				{ "value": "sub", "label": "Sub-section" }
			],
			"default": "main"
		},
		{
			"type": "text",
			"id": "title",
			"label": "Title",
			"default": "Overview"
		},
		{
			"type": "richtext",
			"id": "content",
			"label": "Content"
		}
	],
	"presets": [
		{
			"name": "Policy Item"
		}
	]
}
{% endschema %}

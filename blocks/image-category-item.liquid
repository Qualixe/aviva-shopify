{% liquid
    assign s = block.settings
%}
<div class="slide-content" {{ block.shopify_attributes }} id="block_{{ block.id }}">
    <a href="{{ s.link }}" class="image-category-slider-item">
        <div class="img">
            {% if s.image != blank %}
                {{ s.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: s.title }}
            {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag }}
            {% endif %}
        </div>
        <div class="content">
            {% if s.subtitle != blank %}
                <p class="subtitle">{{ s.subtitle }}</p>
            {% endif %}
            <h2 class="title h5">{{ s.title }}</h2>
        </div>
    </a>
</div>

{% render 'colors-section', block: block %}

{% schema %}
{
    "name": "Category Slide",
    "class": "swiper-slide",
    "settings": [
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "text",
            "id": "subtitle",
            "label": "Subtitle",
            "info": "Optional, e.g. \"flat 20% off\""
        },
        {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "official collections"
        },
        {
            "type": "url",
            "id": "link",
            "label": "Link"
        },
        {
            "type": "header",
            "content": "Color"
        },
        {
            "type": "color",
            "id": "heading_color",
            "label": "Heading Color",
            "default": "{{ settings.color_palette.white_text }}"
        },
        {
            "type": "color",
            "id": "subtitle_bg",
            "label": "Sub Title Background",
            "default": "{{ settings.color_palette.brand_color }}"
        },
        {
            "type": "color",
            "id": "subtitle_color",
            "label": "Sub Title Color",
            "default": "{{ settings.color_palette.white_text }}"
        },
        {
            "type": "color",
            "id": "subtitle_border",
            "label": "Sub Title Border",
            "default": "{{ settings.color_palette.white_text }}"
        }
    ],
    "presets": [
        {
            "name": "Category Slide"
        }
    ]
}
{% endschema %}

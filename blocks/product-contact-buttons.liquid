{% liquid
    assign s = block.settings
    assign product = closest.product
    if request.visual_preview_mode and product == blank
        assign product = collections.all.products.first
    endif
    assign variant = product.selected_or_first_available_variant

    assign whatsapp_base = blank
    if s.whatsapp_number != blank
        assign whatsapp_digits = s.whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
        assign whatsapp_base = 'https://wa.me/' | append: whatsapp_digits
    endif

    assign product_base_url = shop.url | append: product.url
    assign product_full_url = product_base_url | append: '?variant=' | append: variant.id
    assign whatsapp_message = 'Hi, I am interested in ' | append: product.title
    if variant.title != 'Default Title'
        assign whatsapp_message = whatsapp_message | append: ' (' | append: variant.title | append: ')'
    endif
    assign whatsapp_message = whatsapp_message | append: ' - ' | append: product_full_url

    assign whatsapp_url = blank
    if whatsapp_base != blank
        assign encoded_whatsapp_message = whatsapp_message | url_encode
        assign whatsapp_url = whatsapp_base | append: '?text=' | append: encoded_whatsapp_message
    endif
%}
{% if whatsapp_url != blank or s.phone_number != blank %}
    <div class="product-btn-box" {{ block.shopify_attributes }}>
        {% if whatsapp_url != blank %}
            <a
                href="{{ whatsapp_url }}"
                class="btn whatsapp-order-btn"
                target="_blank"
                rel="noopener"
                data-whatsapp-base="{{ whatsapp_base }}"
                data-product-title="{{ product.title | escape }}"
                data-product-url="{{ product_base_url }}"
            >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4.1A8 8 0 1 1 20 11.5Z"></path>
                    <path d="M8.5 8.5c.3-.6.6-.6.9-.1l.7 1.2c.2.3.1.6-.1.8l-.5.5c.6 1.1 1.5 2 2.6 2.6l.5-.5c.2-.2.5-.3.8-.1l1.2.7c.5.3.5.6-.1.9"></path>
                </svg>
                order on whatsapp
            </a>
        {% endif %}
        {% if s.phone_number != blank %}
            <a href="tel:{{ s.phone_number }}" class="btn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6.6 3.5 9 3l2 4-2 1.5a13 13 0 0 0 6.5 6.5L17 13l4 2-.5 2.4a3 3 0 0 1-3.2 2.4C10.4 19 5 13.6 4.2 6.7A3 3 0 0 1 6.6 3.5Z"></path>
                    <path d="M15.5 4.5a6 6 0 0 1 4 4"></path>
                    <path d="M15.5 7.5a3 3 0 0 1 1.5 1.5"></path>
                </svg>
                call for order
            </a>
        {% endif %}
    </div>
{% endif %}

<style>
    .product-btn-box .btn:first-child {
        background: {{ block.settings.whatsapp }};
        border-color: {{ block.settings.whatsapp }};
    }

    .product-btn-box .btn:last-child {
        background: {{ block.settings.call_now }};
        border-color: {{ block.settings.call_now }};
    }

    .product-btn-box .btn:hover {
        background: transparent;
        color: var(--brand-color);
        border-color: var(--brand-color);
    }
</style>

{% schema %}
{
    "name": "Product Contact Buttons",
    "settings": [
        {
            "type": "number",
            "id": "whatsapp_number",
            "label": "WhatsApp Number",
            "default" : 8801318552266,
            "info": "Include country code, e.g. +8801234567890"
        },
        {
            "type": "text",
            "id": "phone_number",
            "label": "Phone Number",
            "info": "Include country code, e.g. +8801234567890"
        },
        {
            "type": "header",
            "content": "Color"
        },
        {
            "type": "color",
            "id": "whatsapp",
            "label": "Whatsapp Background",
            "default" : "{{ settings.color_palette.green }}"
        },
        {
            "type": "color",
            "id": "call_now",
            "label": "Call Now Background",
            "default" : "{{ settings.color_palette.orange }}"
        }
    ],
    "presets": [
        {
            "name": "Product Contact Buttons"
        }
    ]
}
{% endschema %}

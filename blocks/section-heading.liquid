


<div class="section-heading-wrapper" id="block_{{ block.id }}">
    {% if block.settings.heading !=blank %}
         <h2 class="section-heading">{{ block.settings.heading }}</h2>
    {% endif %}
   
    {% if block.settings.button !=blank %}
        <a href="{{ block.settings.link }}" class="card-slider-section-btn">{{ block.settings.button }}<span>›</span></a>
    {% endif %}
    
</div>

{% render 'colors-section', block: block %}


{% schema %}
{
    "name": "Section Heading",
    "class": "section-heading-container",
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "The Travel Edit"    
        }, 
        {
            "type": "text",
            "id": "button",
            "label": "Button"
        }, 
        {
            "type": "url",
            "id": "link",
            "label": "Link"
        }, 
        {
            "type": "color",
            "id": "heading_color",
            "label": "Heading Color",
            "default": "{{ settings.color_palette.brand_color }}"
        },
        {
            "type": "color",
            "id": "btn_color",
            "label": "Button Color",
            "default": "{{ settings.color_palette.brand_color }}"
        }
    ],
    "presets": [
        {
            "name": "Section Heading"
        }
    ]
}
{% endschema %}